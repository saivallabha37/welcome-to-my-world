<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to my world</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;600&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      font-family: 'Montserrat', sans-serif;
      background-color: #111;
      color: #fff;
    }
    header {
      text-align: center;
      padding: 2rem;
      background: linear-gradient(to right, #0f0f0f, #1f1f1f);
      font-size: 2rem;
      font-weight: 600;
      letter-spacing: 2px;
      color: #ff4081;
    }
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 15px;
      padding: 2rem;
    }
    .photo-card {
      position: relative;
      overflow: hidden;
      border-radius: 12px;
      transition: transform 0.3s;
    }
    .photo-card:hover {
      transform: scale(1.03);
    }
    .photo-card img {
      width: 100%;
      height: auto;
      display: block;
    }
    .overlay {
      position: absolute;
      bottom: 0;
      width: 100%;
      background: rgba(0, 0, 0, 0.7);
      display: flex;
      justify-content: space-around;
      padding: 0.5rem 0;
      opacity: 0;
      transition: opacity 0.3s;
    }
    .photo-card:hover .overlay {
      opacity: 1;
    }
    .overlay button {
      background: none;
      border: none;
      color: #ff4081;
      cursor: pointer;
      font-size: 1.2rem;
    }
    .likes-comments {
      display: flex;
      justify-content: space-around;
      margin-top: 0.5rem;
      font-size: 0.9rem;
      color: #ccc;
    }
    footer {
      text-align: center;
      padding: 2rem;
      background: #0a0a0a;
      font-size: 1rem;
      color: #888;
    }
    .contact {
      text-align: center;
      padding: 2rem;
    }
    .contact input, .contact textarea {
      width: 80%;
      max-width: 500px;
      padding: 10px;
      margin: 10px 0;
      border: none;
      border-radius: 6px;
    }
    .contact button {
      background-color: #ff4081;
      color: #fff;
      padding: 10px 20px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <header>Welcome to my world</header>

  <div class="gallery" id="gallery">
    <!-- Photos will be dynamically added here -->
  </div>

  <div class="contact">
    <h2>Contact Me</h2>
    <input type="text" placeholder="Your Name" /><br />
    <input type="email" placeholder="Your Email" /><br />
    <textarea rows="5" placeholder="Your Message"></textarea><br />
    <button>Send</button>
  </div>

  <footer>All photos by Sai Vallabha Linga</footer>

  <script>
    // Example photo list - you can fetch this dynamically from a backend later
    const photos = [
      'photo1.jpg', 'photo2.jpg', 'photo3.jpg'
    ];

    const gallery = document.getElementById('gallery');

    photos.forEach((src, index) => {
      const card = document.createElement('div');
      card.className = 'photo-card';
      card.innerHTML = `
        <img src="${src}" alt="Photo ${index + 1}" />
        <div class="overlay">
          <button onclick="window.open('${src}', '_blank')">🔍</button>
          <button onclick="downloadPhoto('${src}')">⬇️</button>
        </div>
        <div class="likes-comments">
          ❤️ <span id="like-${index}">0</span> &nbsp; 💬 <span id="comment-${index}">0</span>
        </div>
      `;
      gallery.appendChild(card);
    });

    function downloadPhoto(src) {
      const link = document.createElement('a');
      link.href = src;
      link.download = src.split('/').pop();
      link.click();
    }
  </script>
</body>
</html>
